---
import Layout from "../layouts/Layout.astro";


---

<Layout>

<h1 class="text-2xl">Test Astro et Plot (Observablehq)</h1>
<div><a href="/">Acceuil</a></div>
<div id="myplot"></div>
<select name="category" id="category">
  <option value="">All category</option>
  <option  value="Classic">Classic</option>
  <option  value="Vegetarian">Vegetarian</option>
  <option value="Specialty">Specialty</option>
</select>
<script>
    import * as Plot from "@observablehq/plot";
    import pizza from "../assets/pizza.json";
    const categorySelect:HTMLInputElement = document.querySelector("#category")!;
    function affiche() {
      const category = categorySelect.value;
      const plot = Plot.plot({
        marks: [
          Plot.dot(pizza, {
          x: "revenue",
          y: "orders",
          stroke: "category",
            filter: p=>p.category===category || !category
          }),
        ],
      });
  
      const div = document.querySelector("#myplot");
      div.innerHTML="";
      div?.append(plot);
    }

    categorySelect.addEventListener("change",affiche)

    affiche()
  </script>
</Layout>
  
 
